@page
@model MonsterWebShop.Pages.Account.ResetPasswordModel

<h1>Nulstil adgangskode</h1>

<form method="post">

    <input type="hidden" asp-for="Token" />

    <div>
        <label>Ny adgangskode</label>
        <input asp-for="NewPassword" type="password" />
    </div>

    <button type="submit">
        Skift adgangskode
    </button>

</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}