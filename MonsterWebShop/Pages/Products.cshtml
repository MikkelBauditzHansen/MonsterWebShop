@page
@using MonsterWebShop.Models
@model MonsterWebShop.Pages.ProductsModel

@{
    ViewData["Title"] = "Monstre";

    string role = HttpContext.Session.GetString("Role");
    int? accountId = HttpContext.Session.GetInt32("AccountID");
}

<div class="container mt-4">

    <h1 class="text-center mb-4">
        Monster WebShop
    </h1>

    @if (accountId == null)
    {
        <div class="d-flex justify-content-center align-items-center"
             style="min-height: 300px;">

            <div class="text-center">

                <h3>Du er ikke logget ind</h3>

                <p>
                    Log ind eller opret en bruger for at fortsætte.
                </p>

                <a asp-page="/Account/Login"
                   class="btn btn-primary me-2">
                    Log ind
                </a>

                <a asp-page="/Account/Register"
                   class="btn btn-secondary">
                    Registrer
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="products-toolbar mb-5">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h2 class="mb-1">Find dit monster</h2>
                    <p class="text-muted mb-0">
                        Søg i vores udvalg eller vælg en monstertype.
                    </p>
                </div>

                <a asp-page="/Cart"
                   class="btn btn-secondary btn-capsul">

                    <i class="fa fa-shopping-cart me-2"></i>
                    Shopping cart (@Model.CartCount)

                </a>

            </div>


            <form method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5 col-md-6">

                        <label asp-for="SearchText"
                               class="form-label">
                            Søg efter monster
                        </label>

                        <input asp-for="SearchText"
                               class="form-control"
                               placeholder="Navn eller farve" />

                    </div>


                    <div class="col-lg-3 col-md-6">

                        <label asp-for="MonsterType"
                               class="form-label">
                            Monster type
                        </label>

                        <select asp-for="MonsterType"
                                class="form-select">

                            <option value="">Alle typer</option>
                            <option value="Dragon">Dragon</option>
                            <option value="Humanoid">Humanoid</option>
                            <option value="Undead">Undead</option>

                        </select>

                    </div>


                    <div class="col-lg-4">

                        <button type="submit"
                                class="btn btn-primary btn-capsul me-2">

                            <i class="fa fa-search me-1"></i>
                            Søg

                        </button>

                        <a asp-page="/Products"
                           class="btn btn-secondary btn-capsul">

                            Nulstil

                        </a>

                    </div>

                </div>

            </form>

        </div>


        @if (Model.Monsters == null || Model.Monsters.Count == 0)
        {
            <p>
                Ingen produkter matcher din søgning.
            </p>
        }
        else
        {
            <div class="card-container">

                @foreach (var monster in Model.Monsters)
                {
                    <div class="card product-card">

                        <img src="@monster.ImagePath"
                             alt="Billede af @monster.Name"
                             class="card-img-top" />

                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title">
                                @monster.Name
                            </h3>

                            <p class="text-muted mb-2">
                                @if (monster is Dragon)
                                {
                                    <span>Dragon</span>
                                }
                                else if (monster is Humanoid)
                                {
                                    <span>Humanoid</span>
                                }
                                else if (monster is Undead)
                                {
                                    <span>Undead</span>
                                }
                            </p>

                            <div class="product-details mb-3">

                                <p class="mb-1">
                                    Farve: @monster.Color
                                </p>

                                <p class="mb-1">
                                    Alder: @monster.Age år
                                </p>

                                @if (monster is Dragon dragon)
                                {
                                    <p class="mb-1">
                                        Vingefang: @dragon.WingSpan cm
                                    </p>

                                    <p class="mb-1">
                                        Type: @dragon.Type
                                    </p>
                                }

                                @if (monster is Humanoid humanoid)
                                {
                                    <p class="mb-1">
                                        Type: @humanoid.Type
                                    </p>
                                }

                                @if (monster is Undead undead)
                                {
                                    <p class="mb-1">
                                        Type: @undead.Type
                                    </p>
                                }

                            </div>

                            <p class="product-price">
                                @monster.Price DKK
                            </p>

                            <div class="mt-auto">

                                <form method="post"
                                      asp-page-handler="AddToCart">

                                    <input type="hidden"
                                           name="monsterId"
                                           value="@monster.Id" />

                                    <button type="submit"
                                            class="btn btn-primary btn-capsul">
                                        <i class="fa fa-shopping-cart me-1"></i>
                                        Tilføj til kurv
                                    </button>

                                </form>

                                @if (role == "Admin")
                                {
                                    <form method="post"
                                          asp-page-handler="Delete"
                                          class="mt-2">

                                        <input type="hidden"
                                               name="monsterId"
                                               value="@monster.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-capsul">
                                            Slet monster
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
</div>