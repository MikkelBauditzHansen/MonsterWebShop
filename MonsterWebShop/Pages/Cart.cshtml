@page
@using MonsterWebShop.Models
@model MonsterWebShop.Pages.CartModel

@{
    ViewData["Title"] = "Shopping cart";

    int? accountId =
        HttpContext.Session.GetInt32("AccountID");
}

<style>
    .cartPage {
        max-width: 1250px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .cartTitle {
        font-size: 42px;
        font-weight: 600;
        margin-bottom: 30px;
    }

    .cartLayout {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
        gap: 60px;
        align-items: start;
    }

    .cartLeft {
        min-width: 0;
    }

    .cartRight {
        min-width: 0;
    }

    .cartHeading {
        font-size: 28px;
        margin-bottom: 25px;
        font-weight: 500;
    }

    .monsterItem {
        display: grid;
        grid-template-columns: 220px 1fr auto;
        gap: 24px;
        padding: 25px 0;
        border-bottom: 1px solid #dddddd;
    }

    .monsterImageBox {
        width: 220px;
        height: 220px;
        background-color: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .monsterImage {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .monsterName {
        font-size: 21px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .monsterInfo {
        font-size: 17px;
        color: #555555;
        line-height: 1.7;
    }

    .monsterPrice {
        font-size: 19px;
        font-weight: 600;
        white-space: nowrap;
        text-align: right;
    }

    .monsterActions {
        margin-top: 20px;
    }

    .removeButton {
        border: none;
        background: none;
        text-decoration: underline;
        padding: 0;
        font-size: 16px;
        cursor: pointer;
    }

    .summary {
        padding-top: 5px;
    }

    .summaryTitle {
        font-size: 28px;
        font-weight: 500;
        margin-bottom: 35px;
    }

    .summaryRow {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        font-size: 18px;
        margin-bottom: 22px;
    }

    .summaryDivider {
        border: 0;
        border-top: 1px solid #dddddd;
        margin: 30px 0;
    }

    .summaryTotal {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 35px;
    }

    .checkoutButton {
        width: 100%;
        border: none;
        border-radius: 40px;
        background-color: #111111;
        color: white;
        padding: 18px;
        font-size: 18px;
        font-weight: 600;
    }

        .checkoutButton:hover {
            background-color: #333333;
        }

    .backLink {
        display: inline-block;
        margin-bottom: 30px;
        color: #111111;
        text-decoration: underline;
    }

    .emptyCart {
        padding: 40px 0;
    }

    @@media (max-width: 900px) {
        .cartLayout {
            grid-template-columns: 1fr;
        }

        .monsterItem {
            grid-template-columns: 150px 1fr;
        }

        .monsterImageBox {
            width: 150px;
            height: 150px;
        }

        .monsterPrice {
            grid-column: 2;
            text-align: left;
        }
    }
</style>


<div class="cartPage">

    @if (accountId == null)
    {
        <h1 class="cartTitle">
            Shopping cart
        </h1>

        <p>
            Du er ikke logget ind.
        </p>

        <a asp-page="/Account/Login"
           class="btn btn-dark">
            Log ind
        </a>

        <a asp-page="/Account/Register"
           class="btn btn-outline-dark">
            Registrer
        </a>
    }
    else
    {
        <a asp-page="/Products"
           class="backLink">
            ← Tilbage til monstre
        </a>

        <div class="cartLayout">

            <div class="cartLeft">

                <h1 class="cartTitle">
                    Kurv
                </h1>


                @if (Model.MonstersInCart.Count == 0)
                {
                    <div class="emptyCart">

                        <h3>
                            Din kurv er tom
                        </h3>

                        <p>
                            Du har ikke tilføjet nogle monstre endnu.
                        </p>

                        <a asp-page="/Index"
                           class="btn btn-dark">
                            Se monstre
                        </a>

                    </div>
                }
                else
                {
                    @foreach (var monster in Model.MonstersInCart)
                    {
                        <div class="monsterItem">

                            <div class="monsterImageBox">

                                <img src="@monster.ImagePath"
                                     alt="@monster.Name"
                                     class="monsterImage" />

                            </div>


                            <div>

                                <div class="monsterName">
                                    @monster.Name
                                </div>


                                <div class="monsterInfo">

                                    <div>
                                        @monster.Color
                                    </div>

                                    <div>
                                        Alder @monster.Age år
                                    </div>


                                    @if (monster is Dragon dragon)
                                    {
                                        <div>
                                            Vingefang @dragon.WingSpan cm
                                        </div>

                                        <div>
                                            Type @dragon.Type
                                        </div>
                                    }


                                    @if (monster is Humanoid humanoid)
                                    {
                                        <div>
                                            Type @humanoid.Type
                                        </div>
                                    }


                                    @if (monster is Undead undead)
                                    {
                                        <div>
                                            Type @undead.Type
                                        </div>
                                    }

                                </div>


                                <div class="monsterActions">

                                    <form method="post"
                                          asp-page-handler="Remove">

                                        <input type="hidden"
                                               name="monsterId"
                                               value="@monster.Id" />

                                        <button type="submit"
                                                class="removeButton">
                                            Fjern
                                        </button>

                                    </form>

                                </div>

                            </div>


                            <div class="monsterPrice">
                                @monster.Price.ToString("0.00") DKK
                            </div>

                        </div>
                    }
                }

            </div>


            <div class="cartRight">

                <div class="summary">

                    <h2 class="summaryTitle">
                        Oversigt
                    </h2>


                    <div class="summaryRow">

                        <span>
                            Subtotal
                        </span>

                        <span>
                            @Model.Subtotal.ToString("0.00") DKK
                        </span>

                    </div>


                    <div class="summaryRow">

                        <span>
                            Forventet levering
                        </span>

                        <span>
                            @if (Model.Shipping == 0)
                            {
                                <text>Gratis</text>
                            }
                            else
                            {
                                <text>
                                    @Model.Shipping.ToString("0.00") DKK
                                </text>
                            }
                        </span>

                    </div>


                    <hr class="summaryDivider" />


                    <div class="summaryTotal">

                        <span>
                            I alt
                        </span>

                        <span>
                            @Model.Total.ToString("0.00") DKK
                        </span>

                    </div>


                    @if (Model.MonstersInCart.Count > 0)
                    {
                        <button class="checkoutButton">
                            Gå til kassen
                        </button>
                    }

                </div>

            </div>

        </div>
    }

</div>