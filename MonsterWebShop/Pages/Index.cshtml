@page
@using MonsterWebShop.Models
@model IndexModel
@{
    ViewData["Title"] = "Monstre";

    // Session data used for access control
    string role = HttpContext.Session.GetString("Role");
    int? accountId = HttpContext.Session.GetInt32("AccountID");
    string[] allowedRoles = new[] { "Administrator" };
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Monster WebShop</h1>
    @if (accountId == null) 
    { 
        <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;"> 
            <div class="text-center"> 
                <h3>Du er ikke logget ind</h3> 
                <p>Log ind eller opret en bruger for at fortsætte.</p> 
                <a asp-page="/Account/Login" class="btn btn-primary me-2"> Log ind </a>
                <a asp-page="/Account/Register" class="btn btn-secondary"> Registrer </a> 
            </div> 
        </div> 
    } 
    else {
    <div class="mb-3">
        <a asp-page="/Cart" class="btn btn-secondary">
            Shopping cart (@Model.CartCount)
        </a>
    </div>

    <div class="card-container">
        @foreach (var monster in Model.Monsters)
        {
            <div class="card">
                <img src="@monster.ImagePath"
                     alt="Billede af @monster.Name"
                     class="card-img-top" />

                <div class="card-body">
                    <h5 class="card-title">@monster.Name</h5>

                    <p class="card-text">
                        Farve: @monster.Color<br />
                        Alder: @monster.Age år<br />
						Pris: @monster.Price DKK<br />

                        @if (monster is Dragon dragon)
                        {
                            <span>Vingefang: @dragon.WingSpan cm</span>
                            <br />
                            <span>Type: @dragon.Type</span>
                        }
                    </p>

                    <form method="post" asp-page-handler="AddToCart">
                        <input type="hidden" name="monsterId" value="@monster.Id" />

                        <button type="submit" class="btn btn-primary">
                            Tilføj til kurv
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
    }
</div>