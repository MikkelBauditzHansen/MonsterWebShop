@page "/forgotpassword"
@model MonsterWebShop.Pages.Account.ForgotPasswordModel

<h1>Glemt adgangskode</h1>

<form method="post">

    <div>
        <label>Email</label>
        <input asp-for="Email" type="email" />
    </div>

    <button type="submit">Send reset link</button>

</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}