@page
@model MonsterWebShop.Pages.OrderConfirmationModel

@{
    ViewData["Title"] = "Ordrebekræftelse";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="bg-light rounded-3 p-5 text-center shadow-sm">

                <div class="mb-4">
                    <i class="fa fa-check-circle"
                       style="font-size:75px;color:#B47F41;"></i>
                </div>

                <h1 class="fw-bold mb-3">
                    Tak for din ordre!
                </h1>

                <p class="text-muted mb-4">
                    Din simulerede betaling er gennemført,
                    og din ordre er blevet registreret.
                </p>

                <div class="bg-white rounded-3 p-4 text-start mb-4">

                    <div class="d-flex justify-content-between mb-3">
                        <span>Ordrenummer</span>
                        <strong>#@Model.Order.OrderID</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Dato</span>
                        <strong>
                            @Model.Order.OrderDate.ToString("dd-MM-yyyy")
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Betalingsstatus</span>
                        <strong class="text-success">
                            Gennemført (simuleret)
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5">
                        <span class="fw-bold">Total</span>
                        <strong style="color:#B47F41;">
                            @Model.Order.TotalAmount.ToString("N2") DKK
                        </strong>
                    </div>

                </div>

                <a asp-page="/Products"
                   class="btn btn-capsul px-5 py-3 text-white"
                   style="background:#B47F41;">
                    Fortsæt med at shoppe
                </a>

            </div>

        </div>
    </div>
</div>
