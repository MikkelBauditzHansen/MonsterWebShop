@page
@model MonsterWebShop.Pages.ProfileModel

@{
    ViewData["Title"] = "Min Profil";
}

<style>
    .profile-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 50px 25px 90px;
    }

    .profile-title {
        font-size: 2.6rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .profile-subtitle {
        color: #777;
        margin-bottom: 40px;
    }

    .profile-card {
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 12px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.035);
    }

    .profile-card-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .profile-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #f5ede3;
        color: #B47F41;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .profile-label {
        color: #888;
        font-size: 0.85rem;
        margin-bottom: 5px;
    }

    .profile-value {
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .profile-input {
        border-radius: 8px;
        padding: 12px 15px;
    }

        .profile-input:focus {
            border-color: #B47F41;
            box-shadow: 0 0 0 0.2rem rgba(180,127,65,0.15);
        }

    .profile-button {
        background: #B47F41;
        border: none;
        border-radius: 50px;
        padding: 13px 30px;
        color: white;
        font-weight: 600;
        transition: 0.2s;
    }

        .profile-button:hover {
            background: #916634;
            color: white;
        }

    .profile-order-placeholder {
        background: #fafafa;
        border-radius: 10px;
        padding: 35px;
        text-align: center;
        color: #777;
    }
</style>

<div class="profile-page">

    <h1 class="profile-title">Min Profil</h1>

    <p class="profile-subtitle">
        Administrer dine kontooplysninger, din adgangskode og dine ordrer.
    </p>

    <div class="row g-4">

        <!-- Venstre kolonne -->
        <div class="col-lg-5">

            <!-- Kontooplysninger -->
            <div class="profile-card">

                <h2 class="profile-card-title">
                    Mine oplysninger
                </h2>

                <div class="d-flex align-items-center gap-3 mb-4">

                    <div class="profile-avatar">
                        <i class="fa fa-user"></i>
                    </div>

                    <div>
                        <h4 class="fw-bold mb-1">
                            @Model.Account.Username
                        </h4>

                        <span class="text-muted">
                            @Model.Account.Role
                        </span>
                    </div>

                </div>

                <div class="mb-3">
                    <div class="profile-label">Brugernavn</div>
                    <div class="profile-value">
                        @Model.Account.Username
                    </div>
                </div>

                <div>
                    <div class="profile-label">E-mail</div>
                    <div class="profile-value">
                        @Model.Account.Email
                    </div>
                </div>

            </div>

            <!-- Skift adgangskode -->
            <div class="profile-card">

                <h2 class="profile-card-title">
                    Skift adgangskode
                </h2>

                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["PasswordSuccess"]
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-danger">
                        @Model.Message
                    </div>
                }

                <form method="post"
                      asp-page-handler="ChangePassword">

                    <div class="mb-3">
                        <label asp-for="CurrentPassword"
                               class="form-label">
                            Nuværende adgangskode
                        </label>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control profile-input"
                               autocomplete="current-password"
                               required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword"
                               class="form-label">
                            Ny adgangskode
                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control profile-input"
                               autocomplete="new-password"
                               required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="RepeatPassword"
                               class="form-label">
                            Bekræft ny adgangskode
                        </label>

                        <input asp-for="RepeatPassword"
                               type="password"
                               class="form-control profile-input"
                               autocomplete="new-password"
                               required />
                    </div>

                    <button type="submit"
                            class="profile-button w-100">
                        <i class="fa fa-lock me-2"></i>
                        Opdater adgangskode
                    </button>

                </form>

            </div>

        </div>

        <!-- Højre kolonne -->
        <div class="col-lg-7">

            <div class="profile-card">

                <h2 class="profile-card-title">
                    <i class="fa fa-shopping-bag me-2"
                       style="color:#B47F41;"></i>
                    Mine ordrer
                </h2>


                @if (Model.Orders.Count == 0)
                {
                    <div class="profile-order-placeholder">
                        <i class="fa fa-shopping-cart mb-3"
                           style="font-size:2.5rem;color:#B47F41;"></i>

                        <h5 class="fw-bold">Ingen ordrer endnu</h5>

                        <p class="mb-3">
                            Du har ikke gennemført nogen ordrer endnu.
                        </p>

                        <a asp-page="/Products"
                           class="profile-button d-inline-block text-decoration-none">
                            Se monstre
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Ordre</th>
                                    <th>Dato</th>
                                    <th>Beløb</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            #@order.OrderID
                                        </td>

                                        <td>
                                            @order.OrderDate.ToString("dd-MM-yyyy")
                                        </td>

                                        <td>
                                            @order.TotalAmount.ToString("N2") DKK
                                        </td>

                                        <td>
                                            @if (order.PaymentStatus == "Paid")
                                            {
                                                <span class="badge bg-success">
                                                    Gennemført
                                                </span>
                                            }
                                            else if (order.PaymentStatus == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Afventer
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Fejlet
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (order.PaymentStatus == "Paid")
                                            {
                                                <a asp-page="/OrderConfirmation"
                                                   asp-route-orderId="@order.OrderID"
                                                   style="color:#B47F41;"
                                                   class="text-decoration-none fw-semibold">
                                                    Se ordre
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }


            </div>

        </div>

    </div>

</div>
