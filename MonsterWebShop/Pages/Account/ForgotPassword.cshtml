@page "/Account/ForgotPassword"
@model MonsterWebShop.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Glemt adgangskode";
}

<div class="account-page">

    <div class="account-card">

        <div class="text-center mb-4">

            <h1>Glemt adgangskode</h1>

            <p class="text-muted">
                Indtast din email, så sender vi dig et link til at nulstille din adgangskode.
            </p>

        </div>


        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info">
                @Model.Message
            </div>
        }


        <form method="post">

            <div class="mb-4">

                <label class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Indtast din email" />

            </div>


            <button type="submit"
                    class="btn btn-primary btn-capsul account-submit">

                Send reset link

            </button>

        </form>


        <div class="account-footer text-center">

            <a asp-page="/Account/Login">
                ← Tilbage til login
            </a>

        </div>

    </div>

</div>