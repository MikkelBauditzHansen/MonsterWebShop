@page
@using MonsterWebShop.Models
@model MonsterWebShop.Pages.CartModel

@{
    ViewData["Title"] = "Shopping cart";

    int? accountId =
        HttpContext.Session.GetInt32("AccountID");
}

<style>
    .cartPage {
        max-width: 1400px;
        margin: 0 auto;
        padding: 50px 30px 80px;
    }

    .cartTitle {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 35px;
    }

    .cartLayout {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
        gap: 70px;
        align-items: start;
    }

    .cartLeft,
    .cartRight {
        min-width: 0;
    }

    /* Produkt i kurven */
    .monsterItem {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr) auto;
        gap: 25px;
        padding: 25px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .monsterImageBox {
        width: 180px;
        height: 180px;
        background: #f8f9fa;
        border-radius: 10px;
        overflow: hidden;
    }

    .monsterImage {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .monsterName {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .monsterInfo {
        color: #666;
        line-height: 1.7;
    }

    .monsterPrice {
        color: #B47F41;
        font-size: 1.3rem;
        font-weight: 700;
        white-space: nowrap;
        text-align: right;
    }

    .monsterActions {
        margin-top: 18px;
    }

    .removeButton {
        border: none;
        background: transparent;
        color: #666;
        padding: 0;
        font-size: 0.95rem;
        text-decoration: underline;
        cursor: pointer;
    }

        .removeButton:hover {
            color: #B47F41;
        }

    /* Ordreoversigt */
    .summary {
        background: #f8f9fa;
        padding: 35px;
        border-radius: 10px;
        position: sticky;
        top: 90px;
    }

    .summaryTitle {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .summaryRow {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        font-size: 1rem;
        margin-bottom: 20px;
    }

    .summaryDivider {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 25px 0;
    }

    .summaryTotal {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .checkoutButton {
        width: 100%;
        border: none;
        border-radius: 50px;
        background: #B47F41;
        color: #fff;
        padding: 15px 20px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        transition: 0.2s ease;
        display: block;
        text-align: center;
        text-decoration: none;
    }

        .checkoutButton:hover {
            background: #916634;
            color: #fff;
        }

    .backLink {
        display: inline-block;
        margin-bottom: 30px;
        color: #666;
        text-decoration: none;
    }

        .backLink:hover {
            color: #B47F41;
        }

    .emptyCart {
        background: #f8f9fa;
        padding: 50px;
        border-radius: 10px;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .cartLayout {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .monsterItem {
            grid-template-columns: 130px 1fr;
        }

        .monsterImageBox {
            width: 130px;
            height: 130px;
        }

        .monsterPrice {
            grid-column: 2;
            text-align: left;
        }

        .summary {
            position: static;
        }
    }
</style>

<div class="cartPage">

    @if (accountId == null)
    {
        <h1 class="cartTitle">
            Shopping cart
        </h1>

        <p>
            Du er ikke logget ind.
        </p>

        <a asp-page="/Account/Login"
           class="btn btn-primary btn-capsul me-2">
            Log ind
        </a>

        <a asp-page="/Account/Register"
           class="btn btn-secondary btn-capsul">
            Registrer
        </a>
    }
    else
    {
        <a asp-page="/Products"
           class="backLink">
            ← Tilbage til monstre
        </a>

        <div class="cartLayout">

            <div class="cartLeft">

                <h1 class="cartTitle">
                    Kurv
                </h1>


                @if (Model.MonstersInCart.Count == 0)
                {
                    <div class="emptyCart">

                        <h3>
                            Din kurv er tom
                        </h3>

                        <p>
                            Du har ikke tilføjet nogle monstre endnu.
                        </p>

                        <a asp-page="/Products"
                           class="btn btn-primary btn-capsul">
                            Se monstre
                        </a>

                    </div>
                }
                else
                {
                    @foreach (var monster in Model.MonstersInCart)
                    {
                        <div class="monsterItem">

                            <div class="monsterImageBox">

                                <img src="@monster.ImagePath"
                                     alt="@monster.Name"
                                     class="monsterImage" />

                            </div>


                            <div>

                                <div class="monsterName">
                                    @monster.Name
                                </div>


                                <div class="monsterInfo">

                                    <div>
                                        @monster.Color
                                    </div>

                                    <div>
                                        Alder @monster.Age år
                                    </div>


                                    @if (monster is Dragon dragon)
                                    {
                                        <div>
                                            Vingefang @dragon.WingSpan cm
                                        </div>

                                        <div>
                                            Type @dragon.Type
                                        </div>
                                    }


                                    @if (monster is Humanoid humanoid)
                                    {
                                        <div>
                                            Type @humanoid.Type
                                        </div>
                                    }


                                    @if (monster is Undead undead)
                                    {
                                        <div>
                                            Type @undead.Type
                                        </div>
                                    }

                                </div>


                                <div class="monsterActions">

                                    <form method="post"
                                          asp-page-handler="Remove">

                                        <input type="hidden"
                                               name="monsterId"
                                               value="@monster.Id" />

                                        <button type="submit"
                                                class="removeButton">
                                            Fjern
                                        </button>

                                    </form>

                                </div>

                            </div>


                            <div class="monsterPrice">
                                @monster.Price.ToString("0.00") DKK
                            </div>

                        </div>
                    }
                }

            </div>


            <div class="cartRight">

                <div class="summary">

                    <h2 class="summaryTitle">
                        Oversigt
                    </h2>


                    <div class="summaryRow">

                        <span>
                            Subtotal
                        </span>

                        <span>
                            @Model.Subtotal.ToString("0.00") DKK
                        </span>

                    </div>


                    <div class="summaryRow">

                        <span>
                            Forventet levering
                        </span>

                        <span>
                            @if (Model.Shipping == 0)
                            {
                                <text>Gratis</text>
                            }
                            else
                            {
                                <text>
                                    @Model.Shipping.ToString("0.00") DKK
                                </text>
                            }
                        </span>

                    </div>


                    <hr class="summaryDivider" />


                    <div class="summaryTotal">

                        <span>
                            I alt
                        </span>

                        <span>
                            @Model.Total.ToString("0.00") DKK
                        </span>

                    </div>


                    @if (Model.MonstersInCart.Count > 0)
                    {
                        <a asp-page="/Checkout"
                           class="checkoutButton">
                            Gå til kassen
                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>