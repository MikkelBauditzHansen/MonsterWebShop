@page
@using MonsterWebShop.Models
@model MonsterWebShop.Pages.ProductsModel

@{
    ViewData["Title"] = "Monstre";

    string role = HttpContext.Session.GetString("Role");
    int? accountId = HttpContext.Session.GetInt32("AccountID");
}

<div class="container mt-4">

    <h1 class="text-center mb-4">
        Monster WebShop
    </h1>

    @if (accountId == null)
    {
        <div class="d-flex justify-content-center align-items-center"
             style="min-height: 300px;">

            <div class="text-center">

                <h3>Du er ikke logget ind</h3>

                <p>
                    Log ind eller opret en bruger for at fortsætte.
                </p>

                <a asp-page="/Account/Login"
                   class="btn btn-primary me-2">
                    Log ind
                </a>

                <a asp-page="/Account/Register"
                   class="btn btn-secondary">
                    Registrer
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="products-toolbar mb-5">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h2 class="mb-1">Find dit monster</h2>
                    <p class="text-muted mb-0">
                        Søg i vores udvalg eller vælg en monstertype.
                    </p>
                </div>

                <a asp-page="/Cart"
                   class="btn btn-secondary btn-capsul">

                    <i class="fa fa-shopping-cart me-2"></i>
                    Shopping cart (@Model.CartCount)

                </a>

            </div>


            <form method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5 col-md-6">

                        <label asp-for="SearchText"
                               class="form-label">
                            Søg efter monster
                        </label>

                        <input asp-for="SearchText"
                               class="form-control"
                               placeholder="Navn eller farve" />

                    </div>


                    <div class="col-lg-3 col-md-6">

                        <label asp-for="MonsterType"
                               class="form-label">
                            Monster type
                        </label>

                        <select asp-for="MonsterType"
                                class="form-select">

                            <option value="">Alle typer</option>
                            <option value="Dragon">Dragon</option>
                            <option value="Humanoid">Humanoid</option>
                            <option value="Undead">Undead</option>

                        </select>

                    </div>


                    <div class="col-lg-4">

                        <button type="submit"
                                class="btn btn-primary btn-capsul me-2">

                            <i class="fa fa-search me-1"></i>
                            Søg

                        </button>

                        <a asp-page="/Products"
                           class="btn btn-secondary btn-capsul">

                            Nulstil

                        </a>

                    </div>

                </div>

            </form>

        </div>


        @if (Model.Monsters == null || Model.Monsters.Count == 0)
        {
            <p>
                Ingen produkter matcher din søgning.
            </p>
        }
        else
        {
            <div class="card-container">

                @foreach (var monster in Model.Monsters)
                {
                    <div class="card product-card">

                        <img src="@monster.ImagePath"
                             alt="Billede af @monster.Name"
                             class="card-img-top" />

                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title">
                                @monster.Name
                            </h3>

                            <p class="text-muted mb-2">
                                @if (monster is Dragon)
                                {
                                    <span>Dragon</span>
                                }
                                else if (monster is Humanoid)
                                {
                                    <span>Humanoid</span>
                                }
                                else if (monster is Undead)
                                {
                                    <span>Undead</span>
                                }
                            </p>

                            <div class="product-details mb-3">

                                <p class="mb-1">
                                    Farve: @monster.Color
                                </p>

                                <p class="mb-1">
                                    Alder: @monster.Age år
                                </p>

                                @if (monster is Dragon dragon)
                                {
                                    <p class="mb-1">
                                        Vingefang: @dragon.WingSpan cm
                                    </p>

                                    <p class="mb-1">
                                        Type: @dragon.Type
                                    </p>
                                }

                                @if (monster is Humanoid humanoid)
                                {
                                    <p class="mb-1">
                                        Type: @humanoid.Type
                                    </p>
                                }

                                @if (monster is Undead undead)
                                {
                                    <p class="mb-1">
                                        Type: @undead.Type
                                    </p>
                                }

                            </div>

                            <p class="product-price">
                                @monster.Price DKK
                            </p>

                            <div class="mt-auto">

                                <form method="post"
                                      asp-page-handler="AddToCart">

                                    <input type="hidden"
                                           name="monsterId"
                                           value="@monster.Id" />

                                    <button type="submit"
                                            class="btn btn-primary btn-capsul">
                                        <i class="fa fa-shopping-cart me-1"></i>
                                        Tilføj til kurv
                                    </button>

                                </form>

                                @if (role == "Admin")
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-capsul mt-2"
                                            onclick="toggleMonsterEdit(@monster.Id)">
                                        <i class="fa fa-pencil me-1"></i>
                                        Rediger monster
                                    </button>
                                    <form method="post"
                                          asp-page-handler="Delete"
                                          class="mt-2">

                                        <input type="hidden"
                                               name="monsterId"
                                               value="@monster.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-capsul">
                                            Slet monster
                                        </button>

                                    </form>

                                    <div id="edit-monster-@monster.Id"
                                         class="monster-edit-form mt-3 p-3 border rounded"
                                         style="display:none; background:#fafafa;">

                                        <h5 class="fw-bold mb-3">
                                            Rediger @monster.Name
                                        </h5>

                                        <form method="post"
                                              asp-page-handler="Edit"
                                              enctype="multipart/form-data">

                                            <input type="hidden"
                                                   name="monsterId"
                                                   value="@monster.Id" />

                                            <div class="mb-3">
                                                <label class="form-label">Navn</label>
                                                <input type="text"
                                                       name="name"
                                                       value="@monster.Name"
                                                       maxlength="100"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Farve</label>
                                                <input type="text"
                                                       name="color"
                                                       value="@monster.Color"
                                                       maxlength="50"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Skift billede</label>

                                                <input type="file"
                                                       name="newImage"
                                                       accept="image/jpeg,image/png,image/webp"
                                                       class="form-control" />

                                                <small class="text-muted">
                                                    Lad feltet være tomt for at beholde det nuværende billede.
                                                    Maks. 5 MB.
                                                </small>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Alder</label>
                                                <input type="number"
                                                       name="age"
                                                       value="@monster.Age"
                                                       min="0"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Pris (DKK)</label>
                                                <input type="number"
                                                       name="price"
                                                       value="@monster.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                       min="0"
                                                       step="0.01"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            @if (monster is Dragon dragonEdit)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label">Vingefang (cm)</label>
                                                    <input type="number"
                                                           name="wingSpan"
                                                           value="@dragonEdit.WingSpan.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           min="0"
                                                           step="0.01"
                                                           class="form-control"
                                                           required />
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label">Dragetype</label>
                                                    <select name="monsterSubtype"
                                                            class="form-select">
                                                        @foreach (DragonType type in Enum.GetValues<DragonType>())
                                                        {
                                                            <option value="@((int)type)"
                                                                    selected="@(dragonEdit.Type == type)">
                                                                @type
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                            else if (monster is Humanoid humanoidEdit)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label">Humanoidtype</label>
                                                    <select name="monsterSubtype"
                                                            class="form-select">
                                                        @foreach (HumanoidType type in Enum.GetValues<HumanoidType>())
                                                        {
                                                            <option value="@((int)type)"
                                                                    selected="@(humanoidEdit.Type == type)">
                                                                @type
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                            else if (monster is Undead undeadEdit)
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label">Undeadtype</label>
                                                    <select name="monsterSubtype"
                                                            class="form-select">
                                                        @foreach (UndeadType type in Enum.GetValues<UndeadType>())
                                                        {
                                                            <option value="@((int)type)"
                                                                    selected="@(undeadEdit.Type == type)">
                                                                @type
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                            }

                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="submit"
                                                        class="btn btn-success btn-capsul">
                                                    <i class="fa fa-check me-1"></i>
                                                    Gem
                                                </button>

                                                <button type="button"
                                                        class="btn btn-secondary btn-capsul"
                                                        onclick="toggleMonsterEdit(@monster.Id)">
                                                    Annuller
                                                </button>
                                            </div>

                                        </form>
                                    </div>

                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
</div>
@section Scripts {
    <script>
        function toggleMonsterEdit(monsterId) {
            const editForm =
                document.getElementById("edit-monster-" + monsterId);

            if (!editForm) {
                return;
            }

            if (editForm.style.display === "none") {
                editForm.style.display = "block";
            } else {
                editForm.style.display = "none";
            }
        }
    </script>
}